{
  "name": "@u-devtools/electron",
  "private": true,
  "version": "0.1.0",
  "description": "Electron wrapper for Universal DevTools Kit",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "NODE_ENV=production node scripts/build.mjs",
    "dev": "pnpm build && electron dist/main.js",
    "typecheck": "tsc --noEmit",
    "start": "electron dist/main.js",
    "dist": "pnpm build:prod && electron-builder",
    "dist:win": "pnpm build:prod && electron-builder --win",
    "dist:mac": "pnpm build:prod && electron-builder --mac",
    "dist:linux": "pnpm build:prod && electron-builder --linux",
    "dist:all": "pnpm build:prod && electron-builder --win --mac --linux"
  },
  "keywords": [
    "electron",
    "devtools",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/code-frame": "catalog:",
    "@babel/core": "catalog:",
    "@babel/helper-module-imports": "catalog:",
    "@babel/helper-plugin-utils": "catalog:",
    "@babel/parser": "catalog:",
    "@babel/plugin-proposal-decorators": "catalog:",
    "@babel/plugin-syntax-decorators": "catalog:",
    "@babel/plugin-syntax-import-attributes": "catalog:",
    "@babel/plugin-syntax-import-meta": "catalog:",
    "@babel/plugin-syntax-jsx": "catalog:",
    "@babel/plugin-syntax-typescript": "catalog:",
    "@babel/plugin-transform-typescript": "catalog:",
    "@babel/template": "catalog:",
    "@babel/types": "catalog:",
    "@u-devtools/bridge": "workspace:*",
    "@u-devtools/core": "workspace:*",
    "@u-devtools/plugin-componentsbook": "workspace:*",
    "@u-devtools/plugin-console": "workspace:*",
    "@u-devtools/plugin-i18n": "workspace:*",
    "@u-devtools/plugin-inspector": "workspace:*",
    "@u-devtools/plugin-library": "workspace:*",
    "@u-devtools/plugin-manager": "workspace:*",
    "@u-devtools/plugin-network": "workspace:*",
    "@u-devtools/plugin-package-inspector": "workspace:*",
    "@u-devtools/plugin-remote-control": "workspace:*",
    "@u-devtools/plugin-repo2txt": "workspace:*",
    "@u-devtools/plugin-security": "workspace:*",
    "@u-devtools/plugin-seo": "workspace:*",
    "@u-devtools/plugin-storage": "workspace:*",
    "@u-devtools/plugin-tailwind": "workspace:*",
    "@u-devtools/plugin-terminal": "workspace:*",
    "@u-devtools/plugin-vite-inspector": "workspace:*",
    "@u-devtools/plugin-vue-inspector": "workspace:*",
    "@u-devtools/utils-node": "workspace:*",
    "@vue/compiler-core": "catalog:",
    "@vue/compiler-dom": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "chokidar": "catalog:",
    "fast-glob": "catalog:",
    "flatted": "catalog:",
    "globby": "catalog:",
    "ignore": "catalog:",
    "js-tiktoken": "catalog:",
    "json-to-ast": "catalog:",
    "magic-string": "catalog:",
    "markdown-it": "catalog:",
    "vite": "catalog:",
    "vite-plugin-vue-inspector": "catalog:",
    "vue-docgen-api": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/json-to-ast": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:"
  }
}
