{
  "name": "plugin-server-sidecar",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:esbuild": "node build.js",
    "build": "pnpm build:esbuild && npx @yao-pkg/pkg dist/index.js --targets node20-linux-x64,node20-linux-arm64,node20-macos-x64,node20-macos-arm64,node20-win-x64,node20-win-arm64,node20-alpine-x64,node20-alpine-arm64 --out-path . --options experimental-require-module --public-packages \"*\" --public --config package.json && node rename.js"
  },
  "dependencies": {
    "@u-devtools/bridge": "workspace:*",
    "@u-devtools/core": "workspace:*",
    "@u-devtools/plugin-terminal": "workspace:*",
    "@u-devtools/plugin-i18n": "workspace:*",
    "@u-devtools/plugin-manager": "workspace:*",
    "@u-devtools/plugin-seo": "workspace:*",
    "@u-devtools/plugin-tailwind": "workspace:*",
    "@u-devtools/plugin-vite-inspector": "workspace:*",
    "@u-devtools/plugin-vue-inspector": "workspace:*",
    "@u-devtools/plugin-package-inspector": "workspace:*",
    "@u-devtools/plugin-componentsbook": "workspace:*",
    "@u-devtools/plugin-library": "workspace:*",
    "@u-devtools/plugin-remote-control": "workspace:*",
    "@u-devtools/plugin-repo2txt": "workspace:*",
    "ws": "^8"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.11.0",
    "esbuild": "catalog:"
  },
  "pkg": {
    "scripts": [
      "dist/index.js"
    ]
  },
  "babel": {
    "parserOpts": {
      "sourceType": "module",
      "allowImportExportEverywhere": true,
      "allowReturnOutsideFunction": true,
      "plugins": [
        "dynamicImport",
        "importMeta",
        "topLevelAwait"
      ]
    }
  }
}
