{
  "name": "@u-devtools/client",
  "version": "0.2.0",
  "description": "Client-side UI shell for Universal DevTools",
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./src/main.ts"
    },
    "./src/router": "./src/router/index.ts",
    "./src/composables/useDevToolsState": "./src/composables/useDevToolsState.ts",
    "./src/modules/settings": "./src/modules/settings.ts",
    "./src/mocks/plugins": "./src/mocks/plugins.ts",
    "./src/style.css": "./src/style.css",
    "./src/components/shell/*": "./src/components/shell/*",
    "./src/components/settings/*": "./src/components/settings/*",
    "./src/components/*": "./src/components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/main.js",
    "module": "./dist/main.js",
    "types": "./dist/main.d.ts",
    "exports": {
      ".": {
        "types": "./dist/main.d.ts",
        "import": "./dist/main.js"
      },
      "./src/router": "./src/router/index.ts",
      "./src/composables/useDevToolsState": "./src/composables/useDevToolsState.ts",
      "./src/modules/settings": "./src/modules/settings.ts",
      "./src/mocks/plugins": "./src/mocks/plugins.ts",
      "./src/style.css": "./src/style.css",
      "./src/components/shell/*": "./src/components/shell/*",
      "./src/components/settings/*": "./src/components/settings/*",
      "./src/components/*": "./src/components/*",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && pnpm run build:app",
    "build:app": "vite build -c vite.config.app.ts",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:vue": "vue-tsc --noEmit --skipLibCheck",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "devtools",
    "client",
    "ui",
    "shell",
    "u-devtools"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/u-devtools.git",
    "directory": "packages/client"
  },
  "dependencies": {
    "@u-devtools/bridge": "workspace:*",
    "@u-devtools/core": "workspace:*",
    "@u-devtools/ui": "workspace:*",
    "@u-devtools/utils": "workspace:*",
    "@vueuse/core": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "typescript": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "20"
  }
}
