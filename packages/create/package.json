{
  "name": "create-u-devtools",
  "version": "0.2.2",
  "description": "CLI tool to scaffold Universal DevTools plugins",
  "type": "module",
  "bin": {
    "create-u-devtools": "./dist/index.es.js",
    "create-u-devtools-plugin": "./dist/index.es.js"
  },
  "files": [
    "dist",
    "_templates",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.es.js",
        "require": "./dist/index.cjs.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build",
    "hygen": "hygen",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "devtools",
    "plugin",
    "scaffold",
    "generator",
    "cli",
    "u-devtools"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/u-devtools.git",
    "directory": "packages/create"
  },
  "dependencies": {
    "hygen": "catalog:"
  },
  "devDependencies": {
    "vite": "catalog:",
    "@types/node": "catalog:",
    "enquirer": "catalog:",
    "execa": "catalog:",
    "typescript": "catalog:"
  }
}
