{
  "name": "@u-devtools/utils",
  "version": "0.2.2",
  "type": "module",
  "main": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.es.js",
    "module": "./dist/index.es.js",
