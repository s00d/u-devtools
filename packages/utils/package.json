    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "devtools",
    "utilities",
    "helpers",
    "u-devtools"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/u-devtools.git",
    "directory": "packages/utils"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
