{
  "name": "@u-devtools/plugin-console",
  "version": "0.2.2",
  "description": "Console logger plugin for Universal DevTools",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "u-devtools-plugin",
    "devtools",
    "console",
    "logger",
    "logging"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/u-devtools.git",
    "directory": "plugins/console"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.es.js",
        "require": "./dist/index.cjs.js"
      },
      "./client": {
        "import": "./dist/client.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build && vite build -c vite.config.standalone.ts",
    "build:standalone": "vite build -c vite.config.standalone.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:vue": "vue-tsc --noEmit --skipLibCheck",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@u-devtools/core": "workspace:*",
    "@u-devtools/ui": "workspace:*",
    "@u-devtools/utils": "workspace:*",
    "@u-devtools/kit": "workspace:*",
    "@u-devtools/overlay": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "vite": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vue-tsc": "catalog:"
  }
}
